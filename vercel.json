{
  "version": 2,
  "name": "rn174-gemelo-digital-aim",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/demo",
      "dest": "/demo.html"
    },
    {
      "src": "/gestion",
      "dest": "/index.html"
    },
    {
      "src": "/",
      "dest": "/demo.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
